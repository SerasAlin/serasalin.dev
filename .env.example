# Public site URL (used in metadata, sitemap, canonical URLs, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The GitHub username whose public data is fetched for the /github page.
GITHUB_USERNAME=SerasAlin

# Optional: an unscoped GitHub personal-access token increases the API rate
# limit from 60/hour to 5,000/hour. Never expose this to the client.
# GITHUB_TOKEN=

# Contact form provider: log (default, prints to server logs), resend, postmark
CONTACT_EMAIL_PROVIDER=log
# Only required when CONTACT_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# CONTACT_TO_ADDRESS=
